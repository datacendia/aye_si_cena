# Copy to .env.local for local work. Netlify reads these from its own
# environment variables panel — never commit real values.

# Neon: create a project at neon.tech, then Connection Details → connection
# string. Use the POOLED one; the serverless driver wants it.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Signs the session cookie. Generate with:  openssl rand -base64 32
# Change it and everyone is logged out, which is the fastest way to revoke
# every session at once if you ever need to.
AUTH_SECRET=""

# The site's own URL. Auth.js builds callback links from it.
# Local: http://localhost:3000     Netlify: https://your-site.netlify.app
AUTH_URL="http://localhost:3000"

# Your WhatsApp number, digits only, international form — no +, no spaces.
# This is the "Ask on WhatsApp" button on every public page. NEXT_PUBLIC_ means
# it is baked into the page at build time and is visible to anyone, which is
# correct: it is a number you want strangers to have.
NEXT_PUBLIC_WHATSAPP="51999888777"

# A local Postgres works too — the driver follows the URL, so you do not need a
# Neon account to run the app on your own machine:
#   DATABASE_URL="postgresql://postgres@localhost:5432/ayesicena"
