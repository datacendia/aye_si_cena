{
  "name": "ayesicena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "standalone": "node scripts/build-standalone.mjs",
    "standalone:client": "node scripts/build-standalone.mjs --client && node scripts/verify-client-build.mjs",
    "verify:standalone": "node scripts/build-standalone.mjs && node scripts/prep-verify.mjs && node scripts/verify-standalone.mjs $PWD/standalone.html",
    "import-matrix": "python3 scripts/import-matrix.py data/ayesicena-matrix.xlsx && npm run derive-allergens",
    "derive-allergens": "node --experimental-strip-types --import ./scripts/ts-alias.mjs scripts/derive-allergens.mjs",
    "fetch-fonts": "node scripts/fetch-fonts.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "user:create": "node --experimental-strip-types --import ./scripts/ts-alias.mjs scripts/create-user.mjs",
    "book": "node scripts/build-book.mjs",
    "book:es": "node scripts/build-book.mjs --lang es",
    "market-run": "node --experimental-strip-types --import ./scripts/ts-alias.mjs scripts/build-market-run.mjs",
    "market-run:es": "node --experimental-strip-types --import ./scripts/ts-alias.mjs scripts/build-market-run.mjs --lang es"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "jose": "5.9.6",
    "next": "^16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "@types/node": "20.14.12",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "postcss": "^8.5.10",
    "tailwindcss": "3.4.7",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4"
  }
}
